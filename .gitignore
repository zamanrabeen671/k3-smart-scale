# dependencies & build output
node_modules/
dist/
bin/
coverage/
*.tsbuildinfo
*.js.map

# secrets: never commit these
.env*
*.pem
kubeconfig*
k3s.yaml

# pulumi local state
.pulumi/

# misc
*.zip
.DS_Store
cat >> .gitignore <<'EOF'

# lockfiles: pnpm only
package-lock.json
yarn.lock

# logs & editors
*.log
.vscode
.idea

# keep example env file
!.env.example

# pulumi stack configs (only commit ones with NO secrets)
Pulumi.*.yaml
!Pulumi.yaml
!Pulumi.dev.yaml
EOF
